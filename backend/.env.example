# Groq API Key (Obtain from https://console.groq.com/)
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# Provider (groq / ollama)
LLM_PROVIDER=groq

# Models
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=qwen3:8b

# Allowed CORS Origins (Comma-separated origins for production Vercel frontend)
ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app,http://localhost:5173

# Database Connection (Optional MySQL Audit DB)
DATABASE_URL=mysql+pymysql://root:password@localhost/sentinel_ai

# Chroma Persistence Path
CHROMA_DB_PATH=../chroma_storage

# Uploads Folder
UPLOAD_FOLDER=uploads
